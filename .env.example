# Required — OpenRouter is OpenAI-compatible. Any chat model works;
# agents never depend on tool-calling or native JSON mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional — LangSmith. Unset all three and the app is unchanged.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cyber-security-agent

# Off by default. Never enable on the demo path — the text parser is the
# model-independent contract.
USE_NATIVE_STRUCTURED_OUTPUT=false

# Supervisor loop policy (scenario meta.json wins, then these, then defaults).
# Absolute cap cannot be raised past 12.
SUPERVISOR_MAX_ITERATIONS=8
SUPERVISOR_MAX_VISITS_PER_AGENT=1
SUPERVISOR_ABSOLUTE_MAX=12

# --- Phase 2: live threat-intel enrichment -----------------------------------
# Cache mode: live | swr | frozen | bypass. frozen = cache/fixtures only, never
# network — the demo default. Scenario meta.json {"cache": {...}} overrides this.
CACHE_MODE=frozen
CACHE_TTL_DEFAULT=86400
CACHE_TTL_KEV=21600
CACHE_TTL_NEGATIVE=3600

# Optional — raises the NVD 2.0 rate limit from 5 to 50 requests / 30 s.
NVD_API_KEY=

# Source base URLs — override only for mirrors or offline testing.
OSV_API_URL=https://api.osv.dev
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_API_URL=https://api.first.org/data/v1/epss

# Render / PaaS — leave unset locally. On Render these point at the persistent disk.
# CHROMA_DIR=/data/chroma
# CACHE_DIR=/data/cache
# XDG_CACHE_HOME=/data/.cache

